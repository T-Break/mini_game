import pygame,asyncio
import sys
import random
async def main():
    pygame.init()



    screen_x = 800
    screen_y = 500
    screen = pygame.display.set_caption("flying ball")
    screen_2 = pygame.display.set_mode((screen_x,screen_y))




    ball_R = 25.0
    x = random.randint(ball_R,screen_x - ball_R)
    y = 0
    #设定玩家
    add_width = 120
    add_height = 20
    x_2 = screen_x//2 - add_width//2
    y_2 = screen_y//2 - add_height //2
    add = pygame.Surface((add_width,add_height), pygame.SRCALPHA)

    pygame.draw.rect(add, (61, 69, 107), (0,0,add_width,add_height ))
    add_rect = pygame.Rect(x_2,y_2,add_width,add_height )
    #设定游戏对象
    ball = pygame.Surface((ball_R * 2, ball_R * 2), pygame.SRCALPHA)
    pygame.draw.circle(ball, (103, 197, 220), (ball_R, ball_R), ball_R)
    ball_rect = pygame.Rect(x, y, ball_R * 2, ball_R * 2)

    speed_y = 0
    speed_x = 3

    time = pygame.time.Clock()


    1 == True
    2 == False
    fall_change = random.randint(1,2)
    fall_change_2 = random.randint(1,2)
    fall = random.randint(1,2)
    if fall_change == 1:
        fall_change_2 = 2
    elif fall_change == 2:
        fall_change_2 = 1
    dragging = False
    animation = True
    drag_x = 0
    drag_y = 0

    max_speed = 0.5



    score = 0
    font = pygame.font.Font(None,30)
    font_2 = pygame.font.Font(None,45)
    text = font.render('click anywhehre in the window to start the game',True,(100,100,100))

    text_2 = font_2.render('game over',True,(100,100,100))

    game_started = False
    game_over = False


    running = True
    while running:

        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False
                #结束游戏（强制结束）
                pygame.quit()
                sys.exit()
                #接入鼠标


            elif event.type == pygame.MOUSEBUTTONDOWN:
                if event.button == 1:
                    game_started = True
                    dragging = True
                    mouse_x, mouse_y = event.pos
                    if add_rect.collidepoint(event.pos):
                        drag_x = x_2 - mouse_x
                        drag_y = y_2 - mouse_y


            elif event.type == pygame.MOUSEBUTTONUP:
                if event.button == 1:
                    dragging = False


            elif event.type == pygame.MOUSEMOTION:
                if dragging == True:
                    mouse_x, mouse_y = event.pos
                    x_2 = drag_x + mouse_x
                    y_2 = drag_y + mouse_y


        mouse = pygame.mouse.get_pos()

        left = pygame.mouse.get_pressed()

        rel_x, rel_y = pygame.mouse.get_rel()

        if animation:

            if x >= screen_x - ball_R:
                speed_y += 0.05
                y += speed_y
                speed_x = -speed_x

            elif x <= ball_R:
                speed_y += 0.05
                y += speed_y
                speed_x = -speed_x
                #上墙壁回弹
            if y <= -50:
                speed_y = -speed_y
            ball_rect.topleft = (x,y)
            add_rect.topleft = (x_2,y_2)


            if add_rect.colliderect(ball_rect):
                ball_rect.bottom = add_rect.top
                speed_y += 0.8
                speed_y = -speed_y

                score += 1
                add_width -= 10
                if  add_width <= 30:
                    add_width = 30



            if fall == fall_change:
                x += speed_x
                speed_y += 0.05
                y += speed_y


            elif  fall == fall_change_2:
                x -= speed_x
                speed_y += 0.05
                y += speed_y

        if y - ball_R >= screen_y:
            speed = 0
            animation = False
            game_over = True

        if x_2 <= 0:
            x_2 = 0
        elif add_width + x_2 >= screen_x:
            x_2 = screen_x - add_width

        if y_2 <= 0:
            y_2 = 0
        elif add_height + y_2 >= screen_y:
            y_2 = screen_y - add_height


        screen.fill((255, 255, 255))


        if game_started == False:
            animation = False
            screen.blit(text, (screen_x // 5, screen_y // 2))

        elif game_started == True:
            animation = True

            text_3 = font_2.render(f'score : {score}', True, (100, 100, 100))

            screen.blit(text_3, (350, 30))
            add = pygame.Surface((add_width, add_height), pygame.SRCALPHA)
            pygame.draw.rect(add, (61, 69, 107), (0, 0, add_width, add_height))
            add_rect = pygame.Rect(x_2, y_2, add_width, add_height)

            screen.blit(add, (x_2, y_2))
            screen.blit(ball, (x, y))


        if game_over == True :
            animation = False
            screen.blit(text_2, (screen_x//2.5,screen_y//2))
        pygame.display.flip()


        time.tick(60)
        await asyncio.sleep(0)
